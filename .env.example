# ═══════════════════════════════════════════════════════════════════
# ContextForge MCP Gateway - Environment Configuration
# ═══════════════════════════════════════════════════════════════════
#
# IMPORTANT: Copy this file to .env and fill in the required values.
# Generate secrets with: python3 -m mcpgateway.scripts.init_secrets
# Or use the setup script: ./scripts/setup.sh

# ── Required Secrets (MUST be set before starting) ──────────────
# Generate with: python3 -m mcpgateway.scripts.init_secrets
JWT_SECRET_KEY=__REPLACE_ME__
AUTH_ENCRYPTION_SECRET=__REPLACE_ME__

# ── Bootstrap Admin Credentials ─────────────────────────────────
# CHANGE THESE for production!
PLATFORM_ADMIN_EMAIL=admin@yourcompany.com
PLATFORM_ADMIN_PASSWORD=__REPLACE_ME__
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=__REPLACE_ME__

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=mcpgateway
POSTGRES_PASSWORD=__REPLACE_ME__
POSTGRES_DB=contextforge
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Gateway ─────────────────────────────────────────────────────
GATEWAY_PORT=4444
NGINX_PORT=8080

# ── Admin UI/API ────────────────────────────────────────────────
# Set to false in production; expose only via internal network
MCPGATEWAY_UI_ENABLED=true
MCPGATEWAY_ADMIN_API_ENABLED=true

# ── SSRF Protection ────────────────────────────────────────────
# Keep false in production; only allow specific ranges if needed
SSRF_ALLOW_PRIVATE_NETWORKS=false
SSRF_ALLOW_LOCALHOST=false

# ── Observability (OpenTelemetry) ──────────────────────────────
OTEL_ENABLE_OBSERVABILITY=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
